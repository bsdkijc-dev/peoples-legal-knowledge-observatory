{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dataset 04: Public Legal Questions",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "question_id",
      "question_text",
      "audience_category",
      "legal_domain",
      "source_ids",
      "response_status",
      "review_status"
    ],
    "properties": {
      "question_id": {
        "type": "string",
        "pattern": "^QST-[A-Z0-9-]+$"
      },
      "question_text": {
        "type": "string"
      },
      "audience_category": {
        "type": "string"
      },
      "legal_domain": {
        "type": "string",
        "enum": [
          "LK01",
          "LK02",
          "LK03",
          "LK04",
          "LK05",
          "LK06",
          "LK07",
          "LK08",
          "LK09",
          "LK10",
          "LK11",
          "LK12"
        ]
      },
      "source_ids": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^SRC-[A-Z0-9-]+$"
        },
        "minItems": 1
      },
      "response_status": {
        "type": "string",
        "enum": [
          "DRAFTED",
          "ANSWERED",
          "ESCALATED",
          "SYNTHETIC_TEST"
        ]
      },
      "review_status": {
        "type": "string",
        "enum": [
          "PENDING_HUMAN_REVIEW",
          "APPROVED",
          "REJECTED",
          "SYNTHETIC_TEST"
        ]
      }
    },
    "additionalProperties": false
  }
}